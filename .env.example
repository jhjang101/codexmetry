# --- 1. SYSTEM SECURITY ---
SECRET_KEY=generate-a-long-random-string-here

# --- 2. DATABASE CREDENTIALS ---
# Shared by both the App and the Postgres engine
DB_USER=admin
DB_PASSWORD=password
DB_NAME=codexmetry
DB_HOST=db
DB_PORT=5432

# --- 3. INITIAL BOOTSTRAP ---
# Used only during the first launch to create the Root Admin
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=password
INITIAL_ADMIN_EMAIL=admin@example.com

# --- SSO / CLOUDFLARE AUTH ---
# Comma-separated list of IPs allowed to send identity headers (e.g., your Nginx/NPM IP)
TRUSTED_PROXIES=127.0.0.1,172.18.0.1

# The custom HTTP header name and secret value set in your Cloudflare Tunnel
SSO_HEADER_NAME=X-Codexmetry-Secret
SSO_SECRET=generate-a-long-random-string-here